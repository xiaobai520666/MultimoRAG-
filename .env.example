# API 密钥（千问 / 通义千问 DashScope）
QWEN_API_KEY=sk-your-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1

# PostgreSQL 配置
POSTGRES_USER=multimorag
POSTGRES_PASSWORD=multimorag
POSTGRES_DB=multimorag
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://multimorag:multimorag@localhost:5432/multimorag

# Qdrant 向量库配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# 文件上传存储路径
UPLOAD_DIR=./data/uploads

# 端口配置
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 日志级别
LOG_LEVEL=INFO